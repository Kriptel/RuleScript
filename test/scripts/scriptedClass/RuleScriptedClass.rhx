package scriptedClass;

import example.ScriptedClassTest;
import example.ScriptedClassTestStrict;

class ScriptedClass extends ScriptedClassTest
{
	static function helloWorld()
	{
		trace('Hello World');
	}

	public static var variable1:String = 'variable1: Hello World';

	public function new(customArg:Int, arg1:String)
	{
		trace('Constructor.pre: $customArg, $arg1');

		super('Super Arg');

		trace('Constructor.post: $customArg, $arg1');
	}

	override public function info():String
	{
		return 'I Scripted!!!!, super info: ${super.info()}';
	}

	override public function argFunction(a1:Bool, a2:String, a3:String):String
	{
		return '
		argument1: $a1, 
		argument2: $a2, 
		argument3: $a3';
	}

	override public function string(arg:T):String
	{
		return 'Script:' + arg.v;
	}

	override public function stringArray(arg:Array<T>)
	{
		return 'Script: stringArray - ' + Std.string(arg);
	}

	public function scriptFunction()
	{
		return 'scriptFunction: Hello World!';
	}
}

class ScriptedClassStrict extends ScriptedClassTestStrict
{
	public function new(arg1:String)
	{
		trace('Constructor.pre: $arg1');

		super('Super Arg');

		trace('Constructor.post: $arg1');
	}
}
