package abstracts;

abstract AbstractTest(String) from String
{
	function new(arg:String){
		this = arg;
	}

	var HELLO:AbstractTest = "Hello World";

	inline public static function helloWorld():String
	{
		return 'Hello World';
	}
}

private enum abstract LocalAbstractTest(Int)
{
	var ONE;
	var RULESCRIPT;
}
